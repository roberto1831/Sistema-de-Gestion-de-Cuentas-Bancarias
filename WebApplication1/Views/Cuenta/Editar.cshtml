@model BusinessEntity.CuentaBancaria

<h2>Editar Cuenta Bancaria</h2>

<form asp-action="Editar" method="post">
    <div class="form-group">
        <label>Número de Cuenta</label>
        <input asp-for="NumeroCuenta" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label>Cliente</label>
        <input asp-for="Cliente" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar Cambios</button>
    <a asp-action="List" class="btn btn-secondary mt-3 ms-2">Cancelar</a>
</form>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Mensaje
    </div>
}